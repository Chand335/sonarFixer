{
  "name": "chand335/sonar-fixer",
  "description": "Automatic SonarCube PHP code issue fixer using nikic/php-parser",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Chand335",
      "email": "chand335@github.com"
    }
  ],
  "require": {
    "php": ">=7.4",
    "nikic/php-parser": "^4.14"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "autoload": {
    "psr-4": {
      "SonarFixer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SonarFixer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "fix": "php bin/sonar-fixer.php"
  }
}
